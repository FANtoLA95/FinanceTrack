@startuml FinanceTrack Use Case Diagram

left to right direction
skinparam packageStyle rectangle

actor "Руководитель" as Admin
actor "Бухгалтер" as Accountant

Admin --|> Accountant

rectangle "Система FinanceTrack" {
    usecase "Авторизоваться в\nсистеме" as UC_Auth
    usecase "Меню транзакций" as UC_Transactions
    usecase "Меню справочников\nи счетов" as UC_Catalogs
    usecase "Сформировать\nсводный отчёт" as UC_Report
    usecase "Управлять\nпользователями" as UC_Users

    usecase "Просмотреть\nисторию операций" as UC_History
    usecase "Вносить любые\nдоходы/расходы" as UC_AddFinance

    usecase "Создать внутренний\nсчет" as UC_CreateAccount
    usecase "Добавить новую\nкатегорию" as UC_AddCategory
    usecase "Просмотреть баланс\nсчетов" as UC_ViewBalance
}

Accountant -- UC_Auth
Accountant -- UC_Transactions
Accountant -- UC_Catalogs

UC_Transactions -- UC_History
UC_Transactions -- UC_AddFinance

UC_Catalogs -- UC_CreateAccount
UC_Catalogs -- UC_AddCategory
UC_Catalogs -- UC_ViewBalance

Admin -- UC_Report
Admin -- UC_Users

@endum