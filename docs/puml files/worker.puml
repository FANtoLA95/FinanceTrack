@startuml Схема расхода FinanceTrack
skinparam conditionStyle diamond
skinparam linetype ortho

title Добавление расхода

(*) --> "начало"
--> "ввод суммы расхода, выбор\nкатегории и счета" as inputs

if "Все поля заполнены?" then
  -->[да] "запрос текущего баланса\nвыбранного счета из БД" as check_balance
  
  if "Сумма расхода больше\nтекущего баланса?" then
    -->[да] "вывод ошибки 'Недостаточно\nсредств на счете'" as err_funds
    --> "конец" as final_block
  else
    -->[нет] "запись транзакции в\nтаблицу БД" as db_write
    --> "обновление остатка на\nсчете (баланс - сумма)"
    --> "вывод сообщения 'Расход успешно\nзафиксирован'"
    --> final_block
  endif

else
  -->[нет] "вывод ошибки\n'Заполните все поля'" as err_fields
  --> inputs
endif

final_block --> (*)
@endum